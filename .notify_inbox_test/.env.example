RAILS_ENV=production

# PostgreSQL — used by both the db service and the Rails app
POSTGRES_USER=notify_inbox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dn_name
DB_HOST=db
DB_PORT=5432

# Required to decrypt config/credentials.yml.enc
RAILS_MASTER_KEY=

# SSL — set both to false when running without a reverse proxy (plain Docker)
FORCE_SSL=false
ASSUME_SSL=false

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# Host port the app is reachable on (container always listens on 3000)
WEB_PORT=3001

# Prefix for Docker volume paths — leave empty for named volumes,
# set to an absolute path (e.g. /mnt/data/) for bind mounts on production hosts
DOCKER_VOLUMES_PATH_PREFIX=
